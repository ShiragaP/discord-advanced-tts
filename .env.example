# ==========================================
# Discord Advanced Thai TTS (DAT) Configuration
# ==========================================

# Discord Bot Settings
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_COMMAND_PREFIX=!

# TTS Server & Connection Settings
TTS_HOST=0.0.0.0
TTS_PORT=13300
TTS_API_URL=http://127.0.0.1:13300
TTS_API_KEY=

# Model Configuration
TTS_MODEL_TYPE=F5
TTS_LANGUAGE=th
TTS_CHECKPOINT=hf://biodatlab/ThonburianTTS/megaF5/mega_f5_last.safetensors
TTS_VOCAB_FILE=hf://biodatlab/ThonburianTTS/megaF5/mega_vocab.txt
TTS_VOCODER=vocos
TTS_DEVICE=cuda
TTS_ODE_METHOD=euler
TTS_NFE_STEP=32
TTS_CFG_STRENGTH=2.0

# Voice & Playback Defaults
DEFAULT_VOICE_ID=female_default
DEFAULT_SPEED=1.0
MAX_TEXT_LENGTH=250
USER_RATE_LIMIT_SECONDS=2.0

# Audio Caching
CACHE_ENABLED=true
CACHE_MAX_SIZE_MB=2048

# System Paths (Optional overrides)
# FFMPEG_PATH=ffmpeg
