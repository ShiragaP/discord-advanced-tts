# Dockerfile for DAT Discord Bot
FROM python:3.12-slim

WORKDIR /app

# Install FFmpeg and Opus for Discord voice streaming
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libopus0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir "discord.py[voice]>=2.4.0" PyNaCl pydantic pydantic-settings aiosqlite python-dotenv aiohttp pythainlp

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=utf-8
ENV PYTHONPATH=/app

CMD ["python", "run_bot.py"]
